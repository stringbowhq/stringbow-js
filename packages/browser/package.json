{
  "name": "@stringbow/browser",
  "version": "0.2.0",
  "description": "Stringbow browser SDK: evidence collection, enrollment, passkeys and challenges",
  "license": "MIT",
  "homepage": "https://stringbow.dev/docs/browser-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stringbowhq/stringbow-js.git",
    "directory": "packages/browser"
  },
  "bugs": "https://github.com/stringbowhq/stringbow-js/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.1.0"
  },
  "devDependencies": {
    "@stringbow/core": "*"
  }
}
